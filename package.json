{
  "name": "topic-research-folders",
  "version": "0.1.0",
  "description": "Add + to a folder or PDF name to research it into subfolders of easy-to-read notes, with code examples and quiz files.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run"
  },
  "license": "MIT",
  "author": "George Munday",
  "dependencies": {
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "builtin-modules": "^5.4.0",
    "esbuild": "^0.28.2",
    "obsidian": "^1.14.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GeorgeMunday/topic-research-folders.git"
  },
  "homepage": "https://github.com/GeorgeMunday/topic-research-folders#readme",
  "bugs": {
    "url": "https://github.com/GeorgeMunday/topic-research-folders/issues"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "research",
    "notes",
    "pdf",
    "anthropic",
    "claude"
  ]
}
